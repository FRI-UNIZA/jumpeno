@namespace Jumpeno.Client.Images

@inherits IconComponent

<svg
    class="@Class"
    style="@Style"
    width="1em"
    height="1em"
    aria-label="@Label"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 100 100"
    fill="currentColor"
>
    <line
        x1="20"
        y1="20"
        x2="80"
        y2="80"
        stroke="currentColor"
        stroke-width="16"
        stroke-linecap="round"
    />
    <line
        x1="80"
        y1="20"
        x2="20"
        y2="80"
        stroke="currentColor"
        stroke-width="16"
        stroke-linecap="round"
    />
</svg>
