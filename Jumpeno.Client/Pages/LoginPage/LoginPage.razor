@namespace Jumpeno.Client.Pages

@inherits Page
@attribute [Route(LoginPage.ROUTE_EN)]
@attribute [Route(LoginPage.ROUTE_SK)]

<DocTitle Value="@I18N.T("Login")" />

<div class="login-page">
    @switch (VM.Form) {
        case LoginFormType.Admin: <AdminLoginForm VM="VM" /> break;
        case LoginFormType.PasswordReset: <PasswordResetForm VM="VM" /> break;
        case LoginFormType.Register: <RegisterForm VM="VM" /> break;
        case LoginFormType.User: <UserLoginForm VM="VM" /> break;
    }
</div>
