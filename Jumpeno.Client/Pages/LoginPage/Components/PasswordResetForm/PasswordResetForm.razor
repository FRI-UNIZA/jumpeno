@namespace Jumpeno.Client.Components

@inherits BasicComponent

<DocTitle Value="@I18N.T("Reset password")" />

<div class="password-form">
    <Heading1 Class="password-heading" Size="TextSize.L">@I18N.T("Reset password")</Heading1>
    <div class="form-inputs">
        <InputField ViewModel="VMEmail" Name="email" Label="@I18N.T("Email address verification")" Size="FormSize.M" Align="FormAlign.Center" Autocomplete />
    </div>
    <Button Size="ButtonSize.M" OnClick="Send">
        <Text>@I18N.T("Send")</Text>
    </Button>
    <WebLink
        Size="TextSize.S"
        NoWrap
        OnClick="() => VM.Show(LoginFormType.User)"
        OnEnter="() => VM.Show(LoginFormType.User)"
    >
        <AntIcon Type="login" Theme="outline" Class="icon-login" />&nbsp;@I18N.T("Login")&nbsp;
    </WebLink>
</div>
