@namespace Jumpeno.Client.Components

@inherits BasicComponent

<DocTitle Value="@I18N.T("Registration")" />

<div class="register-form">
    @if (!Success) {
        <div class="register-form-content">
            <div class="register-box">
                <Heading1 Class="register-heading" Size="TextSize.L">@I18N.T("Registration")</Heading1>
                <div class="register-inputs">
                    <InputField ViewModel="VMEmail" Name="email" Label="@I18N.T("Email")" Size="FormSize.M" Align="FormAlign.Center" Autocomplete />
                    <InputField ViewModel="VMPlayerName" Name="name" Label="@I18N.T("Player name")" Size="FormSize.M" Align="FormAlign.Center" />
                    <InputField ViewModel="VMPassword" Name="password" Label="@I18N.T("Password")" Size="FormSize.M" Align="FormAlign.Center" />
                    <InputField ViewModel="VMConfirmPassword" Name="confirm password" Label="@I18N.T("Confirm password")" Size="FormSize.M" Align="FormAlign.Center" />
                </div>
                <Box Surface="BoxSurface.PrimaryTransparent" Class="password-strength-box-mobile">
                    <PasswordStrength Password="@Password" HideLock />
                </Box>
                <ReCAPTCHA @ref="ReCAPTCHARef" Form="@FORM" ID="@nameof(UserRegisterDTO.CAPTCHAToken)" />
                <Button Size="ButtonSize.M" OnClick="Register" Class="button-register">
                    <Text>@I18N.T("Register")</Text>
                </Button>
                <Paragraph Size="TextSize.S" Class="register-block">
                    @I18N.T("Have an account?")&nbsp;
                    <WebLink Size="TextSize.S"
                        NoWrap
                        OnClick="() => VM.Show(LoginFormType.User)"
                        OnEnter="() => VM.Show(LoginFormType.User)"
                        Underline
                    >
                        @I18N.T("Log in")
                    </WebLink>
                </Paragraph>
            </div>
            <Box Surface="BoxSurface.PrimaryTransparent" Class="password-strength-box">
                <PasswordStrength Password="@Password" />
            </Box>
        </div>
    } else {
        <div class="register-success-box">
            <Heading1 Class="register-heading" Size="TextSize.L">@I18N.T("Registration successful.")</Heading1>
            <AntIcon Type="check-circle" Theme="outline" Class="register-icon" />
            <div class="activation-box">
                <Paragraph Class="activation-text">@I18N.T("In order to play, account must be activated!")</Paragraph>
                <Paragraph Class="activation-text-info">@I18N.T("Activation link was sent to your email address.")</Paragraph>
                <Paragraph Class="activation-text-info">(@I18N.T("You can always ask for new one in profile."))</Paragraph>
            </div>
            <WebLink
                Size="TextSize.S"
                NoWrap
                OnClick="() => VM.Show(LoginFormType.User)"
                OnEnter="() => VM.Show(LoginFormType.User)"
                Class="register-redirect"
            >
                <AntIcon Type="login" Theme="outline" Class="icon-login" />&nbsp;@I18N.T("Log in")&nbsp;
            </WebLink>
        </div>
    }
</div>
