@namespace Jumpeno.Client.Pages

@inherits Page
@attribute [Route(GameControllerPage.ROUTE_EN)]
@attribute [Route(GameControllerPage.ROUTE_SK)]

<div class="game-controller-page">
    <DocTitle Value="@I18N.T("Game controller")" />
    <div class="game-controller-form">
        <Heading1 Size="TEXT_SIZE.L" Class="game-controller-heading">@I18N.T("Game controller")</Heading1>
        <div class="form-inputs">
            <InputField ViewModel="VMCode" Name="code" Label="@I18N.T("Code")" Size="FORM_SIZE.M" Align="FORM_ALIGN.CENTER" />
        </div>
    </div>
    <div>
        <Button Variant="BUTTON_VARIANT.DANGER" Size="BUTTON_SIZE.L" OnClick="Delete">
            <Icon><AntIcon Type="delete" Theme="outline" Label="@I18N.T("Delete")" /></Icon>
        </Button>
        <Button Size="BUTTON_SIZE.M" OnClick="Toggle">
            <Icon><AntIcon Type="caret-right" Theme="outline" Label="@I18N.T("Start")" /></Icon>
            <Text>/</Text>
            <IconAfter><AntIcon Type="pause" Theme="outline" Label="@I18N.T("Pause")" /></IconAfter>
        </Button>
    </div>
    <ConfirmModal @ref="DeleteConfirmModalRef" Label="@I18N.T("Delete game")" Danger>
        <Icon><AntIcon Type="delete" Theme="outline" Label="@I18N.T("Delete")" /></Icon>
        <Message>@I18N.T("Do you really want to delete this game?")</Message>
        <TextOK>@I18N.T("Delete")</TextOK>
    </ConfirmModal>
</div>
