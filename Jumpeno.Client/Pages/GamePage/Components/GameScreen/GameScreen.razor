@namespace Jumpeno.Client.Components

@{ #pragma warning disable CS8600 }
@{ #pragma warning disable CS8602 }

@inherits BasicComponent

<div class="@ComputeClass()">
    <GameCanvas @ref="Canvas" Game="VM.Game" Player="VM.Player" />

    <div class="game-info">
        <div class="game-menu">
            @if (VM.IsHost) {
                <GameTextButton Class="game-pause-button" Action="new(VM.Pause)">
                    <ThumbButton Class="game-pause-button-thumb" />
                    <AntIcon Type="pause-circle" Theme="fill" Class="game-pause-button-icon" />
                </GameTextButton>
            } else {
                <GameTextButton Class="game-lobby-button" Action="new(VM.ShowLobby)">
                    <ThumbButton Class="game-lobby-button-thumb" />
                    <MenuSVG Class="game-lobby-button-icon" />
                </GameTextButton>
            }
            @if (VM.IsPlayer) {
                <GameTextButton Class="keyboard-display-button" Action="new(VM.ToggleControls)">
                    <ThumbButton Class="keyboard-display-button-thumb" />
                    <KeyboardSVG Class="keyboard-display-button-icon" />
                </GameTextButton>
            } else {
                <GameTextButton Class="game-chat-button" Action="new(VM.Chat.Open)" Disabled>
                    <ThumbButton Class="game-chat-button-thumb" />
                    <AntIcon Type="message" Theme="fill" Class="game-chat-button-icon" />
                </GameTextButton>
            }
        </div>
        <p class="game-time">@Format.Ms_To_MMSS(VM.Game.Time)</p>
        <p class="trademark faculty-name"><span class="copy-sign">&copy;</span>FRI UNIZA</p>
        <div class="game-connected">
            <p class="connect-text">@I18N.T("Screen connected")</p>
            <AntIcon Type="wifi" Theme="outline" Class="connect-icon" />
        </div>
        <p class="game-ping">@($"Ping"):&nbsp;&nbsp;<strong>@Format.DoubleWhole(VM.Ping)</strong></p>
    </div>

    <div class="@GameControlsClass()">
        @code {
            private RenderFragment RenderControl(GameControls control, RenderFragment icon) =>
                @<div
                    class="control-wrap"
                    @ontouchstart="TouchKeyEvent(control)" @ontouchend="ReleaseKeyEvent(control)"
                    @ontouchstart:preventDefault @ontouchend:preventDefault
                    @ontouchstart:stopPropagation @ontouchend:stopPropagation
                >
                    <button
                        class="@ControlClass(control)"
                        type="@ButtonType.BUTTON.String()"
                        @onmousedown="MouseTouchKeyEvent(control)"
                        tabindex="-1"
                    >
                        @icon
                    </button>
                </div>
            ;
        }
        <div class="arrows">
            @RenderControl(GameControls.LEFT, @<AntIcon Type="left" Theme="outline" Class="control-icon" />)
            @RenderControl(GameControls.RIGHT, @<AntIcon Type="right" Theme="outline" Class="control-icon" />)
        </div>
        <div class="abilities">
            @RenderControl(GameControls.SPACE, @<AntIcon Type="to-top" Theme="outline" Class="control-icon" />)
        </div>
    </div>

    <GameInfoBox Class="flip-device" Type="rotate-left" Theme="outline">@I18N.T("Rotate screen")</GameInfoBox>
    <GameInfoBox Class="small-device" Type="fullscreen" Theme="outline">@I18N.T("Screen too small")</GameInfoBox>
</div>
