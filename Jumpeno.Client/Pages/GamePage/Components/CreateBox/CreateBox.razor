@namespace Jumpeno.Client.Components

@inherits BasicComponent

<div class="@ComputeClass()">
    <AuthView Roles="[Role.USER]">
        <Box Class="create-form">
            <BoxHeader class="create-form-header">
                <Heading1 Size="TextSize.L" Class="create-heading">@I18N.T("Create game")</Heading1>
                <div class="create-form-header-options">
                    <WebLink
                        Href="@(I18N.Link<GamePage>())" HrefPrevent
                        OnClick="GamePage.NavigateToConnect"
                        Class="connect-link-cancel"
                    >
                        <AntIcon Type="double-left" Theme="outline" Class="connect-icon" />
                        &nbsp;@I18N.T("Cancel")&nbsp;
                    </WebLink>
                    <Button Size="ButtonSize.S" OnClick="Create" Class="create-game-button">
                        <Text>@I18N.T("Create")</Text>
                        <IconAfter><AntIcon Type="plus-circle" Theme="Outline"/></IconAfter>
                    </Button>
                </div>
            </BoxHeader>
            <div class="game-identifiers">
                <AntIcon Type="setting" Theme="Outline" Class="settings-icon" />
                <Image URL="@ImageType.JUMPER_YELLOW" Transparent NoTransition Class="logo-image" />
                <AntIcon Type="qrcode" Theme="Outline" Class="qr-code-icon" />
                <FormLabel Label="@I18N.T("Game name")" Size="FormSize.L" Align="FormAlign.CENTER" Class="game-name-label">
                    <InputField ViewModel="VMInputName" Name="name" Label="@I18N.T("Game name")" Size="FormSize.M" Align="FormAlign.CENTER" AllowClear Class="game-name-input" />
                </FormLabel>
                <div class="custom-code">
                    <CheckBoxField ViewModel="VMCheckBoxCode" Label="@I18N.T("Custom code")" Size="FormSize.S" ErrorAlign="FormAlign.CENTER" ActiveDescription AutoSize Class="custom-code-checkbox" >
                        <Description>@I18N.T("Custom code")</Description>
                    </CheckBoxField>
                    <InputField ViewModel="VMInputCode" Name="code" Label="@I18N.T("Custom code")" Size="FormSize.S" Align="FormAlign.CENTER" Disabled="VMInputCodeDisabled" Class="custom-code-input" />
                </div>
            </div>
            <div class="game-options">
                <Paragraph class="map-title-mobile">@I18N.T("Map")</Paragraph>
                <div class="game-options-area">
                    <Paragraph class="map-title">@I18N.T("Map")</Paragraph>
                    <div class="map-option">
                        <LoadArea
                            ViewModel="GameMapSelectLoadArea"
                            Type="LoadAreaType.FOCUS_LOADING"
                            Label="@I18N.T("Select map")"
                            LoadLabel="@($"{I18N.T("Select map")}, {@I18N.T("Disabled field")}")"
                            RoleDescription="combobox"
                            Class="@LoadAreaMapOptionClass()"
                            NoStyle
                            NoLoader
                        >
                            <SelectField
                                ViewModel="VMSelectMap"
                                Disabled="VMSelectMapDisabled"
                                Label="@I18N.T("Select map")"
                                Align="FormAlign.LEFT"
                                OptionAlign="SelectOptionAlign.CENTER"
                                Size="FormSize.S"
                                Class="map-select"
                                ModalClass="create-box-map-select-modal"
                            />
                            <AntIcon Type="caret-right" Theme="Outline" Class="create-box-map-icon" />
                        </LoadArea>
                    </div>
                    <div class="gameplay-options">
                        <FormLabel Label="@I18N.T("TEXT_ANONYMOUS_PLAYERS")" Size="FormSize.L" Align="FormAlign.CENTER" Class="anonymous-players-label">
                            <SwitchField
                                ViewModel="VMSwitchAnonyms"
                                Label="@I18N.T("TEXT_ANONYMOUS_PLAYERS")"
                                Size="FormSize.M"
                                Class="anonymous-players-switch"
                                Position="SwitchPosition.END"
                                Align="FormAlign.CENTER"
                                ActiveDescription
                                AutoSize
                            >
                                <Description>
                                    <AnonymSVG Class="anonymous-players-svg" />
                                </Description>
                            </SwitchField>
                        </FormLabel>
                        <div class="game-additional-options">
                            <div class="rounds-option">
                                <SelectField
                                    ViewModel="VMSelectRounds"
                                    Label="@I18N.T("Number of rounds")"
                                    Align="FormAlign.LEFT"
                                    OptionAlign="SelectOptionAlign.CENTER"
                                    Size="FormSize.S"
                                    Class="rounds-select"
                                    ModalClass="create-box-rounds-select-modal"
                                />
                                <AntIcon Type="clock-circle" Theme="Outline" Class="rounds-icon" />
                            </div>
                            <div class="capacity-option">
                                <SelectField
                                    ViewModel="VMSelectCapacity"
                                    Label="@I18N.T("Capacity")"
                                    Align="FormAlign.LEFT"
                                    OptionAlign="SelectOptionAlign.CENTER"
                                    Size="FormSize.S"
                                    Class="capacity-select"
                                    ModalClass="create-box-capacity-select-modal"
                                />
                                <AntIcon Type="team" Theme="Outline" Class="capacity-icon" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="map-canvas-icons">
                    <AntIcon Type="more" Theme="Outline" Class="map-canvas-more-icon-left" />
                    <AntIcon Type="more" Theme="Outline" Class="map-canvas-more-icon-right" />
                </div>
                <div class="map-canvas-area">
                    <LoadArea
                        ViewModel="GameMapLoadArea"
                        Label="@I18N.T("Map")"
                        LoadLabel="@I18N.T("Map loading")"
                        RoleDescription="@I18N.T("Image")"
                        Class="load-area-canvas"
                    >
                        <MapCanvas Map="GameMap" Class="map-canvas">
                            @if (!GameMapLoadArea.Loading) {
                                @if (VMSelectMapError) {
                                    <Paragraph Size="TextSize.L" Class="error-title">@I18N.T("Error")</Paragraph>
                                    <Paragraph Size="TextSize.S" Class="error-description">@I18N.T("Maps could not be loaded")</Paragraph>
                                    <Button id="@ID_BUTTON_TRY_AGAIN" Variant="ButtonVariant.TERTIARY" NoShadow Size="ButtonSize.S" OnClick="LoadMaps">
                                        <Text>@I18N.T("Try again")</Text>
                                    </Button>
                                } else if (VMSelectMapOptions.Count <= 0) {
                                    <Paragraph Size="TextSize.L" Class="error-title">@I18N.T("Error")</Paragraph>
                                    <Paragraph Size="TextSize.S" Class="error-description">@I18N.T("Empty map list")</Paragraph>
                                    <Button id="@ID_BUTTON_TRY_AGAIN" Variant="ButtonVariant.TERTIARY" NoShadow Size="ButtonSize.S" OnClick="LoadMaps">
                                        <Text>@I18N.T("Try again")</Text>
                                    </Button>
                                } else if (GameMapError) {
                                    <Paragraph Size="TextSize.L" Class="error-title">@I18N.T("Error")</Paragraph>
                                    <Paragraph Size="TextSize.S" Class="error-description">@I18N.T("Map could not be loaded")</Paragraph>
                                    <Button id="@ID_BUTTON_TRY_AGAIN" Variant="ButtonVariant.TERTIARY" NoShadow Size="ButtonSize.S" OnClick="() => LoadMap(VMSelectMap.Value.Value)">
                                        <Text>@I18N.T("Try again")</Text>
                                    </Button>
                                }
                            }
                        </MapCanvas>
                    </LoadArea>
                </div>
            </div>

            <FormLabel Label="@I18N.T("Display mode")" Size="FormSize.L" Align="FormAlign.CENTER" Class="display-mode">
                <RadioButton ViewModel="VMRadioDisplayMode" Label="@I18N.T("Display mode")" AutoSize>
                    @if (true) {
                        var option = VMRadioDisplayModeOptions[0];
                        <RadioButtonOption
                            Class="radio-display-mode radio-display-mode-each-own"
                            ViewModel="option"
                            Label="@($"{I18N.T("Display mode")}: {option.Label}")"
                            Align="FormAlign.CENTER"
                            AutoSize
                        >
                            <DisplayModeEachOwnSVG Class="option-each-own-svg" />
                            <div class="display-mode-description">
                                <p class="option-label">@option.Label</p>
                                <p class="option-description">@VMRadioDisplayModeDescriptions[option.Key]</p>
                            </div>
                        </RadioButtonOption>
                    }
                    @if (true) {
                        var option = VMRadioDisplayModeOptions[1];
                        <RadioButtonOption
                            Class="radio-display-mode radio-display-mode-one-screen"
                            ViewModel="option"
                            Label="@($"{I18N.T("Display mode")}: {option.Label}")"
                            Align="FormAlign.CENTER"
                            AutoSize
                        >
                            <DisplayModeOneScreenSVG Class="option-one-screen-svg" />
                            <div class="display-mode-description">
                                <p class="option-label">@option.Label</p>
                                <p class="option-description">@VMRadioDisplayModeDescriptions[option.Key]</p>
                            </div>
                        </RadioButtonOption>
                    }
                    @if (true) {
                        var option = VMRadioDisplayModeOptions[2];
                        <RadioButtonOption
                            Class="radio-display-mode radio-display-mode-presentation"
                            ViewModel="option"
                            Label="@($"{I18N.T("Display mode")}: {option.Label}")"
                            Align="FormAlign.CENTER"
                            AutoSize
                        >
                            <DisplayModePresentationSVG Class="option-presentation-svg" />
                            <div class="display-mode-description">
                                <p class="option-label">@option.Label</p>
                                <p class="option-description">@VMRadioDisplayModeDescriptions[option.Key]</p>
                            </div>
                        </RadioButtonOption>
                    }
                </RadioButton>
            </FormLabel>
            @if (VMRadioDisplayMode.Value != null) {
                <Paragraph Class="display-mode-dynamic-description">@VMRadioDisplayModeDescriptions[VMRadioDisplayMode.Value.Key]</Paragraph>
            }

            <FormLabel Label="@I18N.T("Game mode")" Size="FormSize.L" Align="FormAlign.CENTER" Class="game-mode">
                <RadioButton ViewModel="VMRadioGameMode" Label="@I18N.T("Game mode")" AutoSize>
                    @if (true) {
                        var option = VMRadioGameModeOptions[0];
                        <RadioButtonOption
                            Class="radio-game-mode radio-game-mode-mayhem"
                            ViewModel="option"
                            Label="@($"{I18N.T("Game mode")}: {option.Label}")"
                            Align="FormAlign.CENTER"
                            AutoSize
                        >
                            <p class="option-label">
                                <GameModeMayhemSVG Class="option-mayhem-svg" />
                                <span class="option-label-text">@option.Label</span>
                            </p>
                            <p class="option-description">@VMRadioGameModeDescriptions[option.Key]</p>
                        </RadioButtonOption>
                    }
                    @if (true) {
                        var option = VMRadioGameModeOptions[1];
                        <RadioButtonOption
                            Class="radio-game-mode radio-game-mode-last-standing"
                            ViewModel="option"
                            Label="@($"{I18N.T("Game mode")}: {option.Label}")"
                            Align="FormAlign.CENTER"
                            AutoSize
                        >
                            <p class="option-label">
                                <GameModeLastStandingSVG Class="option-last-standing-svg" />
                                <span class="option-label-text">@option.Label</span>
                            </p>
                            <p class="option-description">@VMRadioGameModeDescriptions[option.Key]</p>
                        </RadioButtonOption>
                    }
                </RadioButton>
            </FormLabel>
            @if (VMRadioGameMode.Value != null) {
                <Paragraph Class="game-mode-dynamic-description">@VMRadioGameModeDescriptions[VMRadioGameMode.Value.Key]</Paragraph>
            }
        </Box>
    </AuthView>
    <AuthViewBlock Roles="[Role.USER]">
        <div class="create-box-error-page">
            <Heading1 Size="TextSize.XL" Class="error-page-heading">@I18N.T("Error 403")</Heading1>
            <Paragraph Size="TextSize.L" Class="error-page-paragraph">@I18N.T("You are not authorized to create games.")</Paragraph>
            <WebLink
                Href="@(I18N.Link<GamePage>())" HrefPrevent
                OnClick="GamePage.NavigateToConnect"
                Class="connect-link"
            >
                <AntIcon Type="play-circle" Theme="outline" Class="connect-icon" />
                &nbsp;@I18N.T("Connect")&nbsp;
            </WebLink>
        </div>
    </AuthViewBlock>
</div>
