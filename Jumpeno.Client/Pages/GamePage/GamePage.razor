@namespace Jumpeno.Client.Pages

@inherits Page
@attribute [Route(GamePage.RouteEN)]
@attribute [Route(GamePage.RouteSK)]

<DocTitle Value="@I18N.T("Game")" />

<div class="game-page">
    @if (GameVM is null) {
        if (!_connectVm.Create) {
            <ConnectBox @key="@nameof(ConnectBox)" @ref="View" VM="_connectVm" />
        } else {
            <CreateBox @key="@nameof(CreateBox)" @ref="View" VM="_connectVm" />
        }
    } else {
        <GameChat @key="@nameof(GameChat)" @ref="ChatRef" VM="GameVM" />
        switch (GameVM.Game.State) {
            case GameStates.Lobby:
            case GameStates.Pause:
            case GameStates.ScoreBoard:
                <Lobby @key="@nameof(Lobby)" @ref="View" VM="GameVM" />
            break;
            case GameStates.GamePlay:
            case GameStates.Shrinking:
                if (GameVM.LobbyDisplayed) {
                    <Lobby @key="@nameof(Lobby)" @ref="View" VM="GameVM" />
                } else {
                    <GameScreen @key="@nameof(GameScreen)" @ref="View" VM="GameVM" />
                }
            break;
        }
    }
</div>
