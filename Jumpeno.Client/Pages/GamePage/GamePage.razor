@namespace Jumpeno.Client.Pages

@inherits Page
@attribute [Route(GamePage.ROUTE_EN)]
@attribute [Route(GamePage.ROUTE_SK)]

<DocTitle Value="@I18N.T("Game")" />

<div class="game-page">
    @if (GameVM is null) {
        if (!ConnectVM.Create) {
            <ConnectBox @key="@nameof(ConnectBox)" @ref="View" VM="ConnectVM" />
        } else {
            <CreateBox @key="@nameof(CreateBox)" @ref="View" VM="ConnectVM" />
        }
    } else {
        <GameChat @key="@nameof(GameChat)" @ref="ChatRef" VM="GameVM" />
        switch (GameVM.Game.State) {
            case GAME_STATE.LOBBY:
            case GAME_STATE.PAUSE:
            case GAME_STATE.SCOREBOARD:
                <Lobby @key="@nameof(Lobby)" @ref="View" VM="GameVM" />
            break;
            case GAME_STATE.GAMEPLAY:
            case GAME_STATE.SHRINKING:
                if (GameVM.LobbyDisplayed) {
                    <Lobby @key="@nameof(Lobby)" @ref="View" VM="GameVM" />
                } else {
                    <GameScreen @key="@nameof(GameScreen)" @ref="View" VM="GameVM" />
                }
            break;
        }
    }
</div>
