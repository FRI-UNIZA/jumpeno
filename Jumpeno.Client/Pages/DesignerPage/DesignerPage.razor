@namespace Jumpeno.Client.Pages

@inherits Page
@attribute [Route(DesignerPage.RouteEn)]
@attribute [Route(DesignerPage.RouteSk)]

@code {
    private RenderFragment Render(DesignerSurface surface) => @<Fragment>
        <Container Class="@GetClassSurface(surface.Surface)">
            <Heading2 Size="TextSize.S" Spacing Class="@ClassHeading">@surface.Surface</Heading2>
            <div class="@ClassContainer">
                <PlayGround />
            </div>
            @foreach (var child in surface.Iterator) {
                @Render(child)
            }
        </Container>
    </Fragment>;

    private RenderFragment Render() => @<Fragment>
        @foreach (var surface in Surfaces) {
            @Render(surface)
        }
    </Fragment>;
}

@if (AppEnvironment.IsDevelopment) {
    <DocTitle Value="@I18N.T("Designer")" />
    <div class="@ClassPage">
        <Heading1 Spacing Class="@ClassHeadingMain">@nameof(Surface)</Heading1>
        @Render()
    </div>
} else {
    <Error404Page />
}
