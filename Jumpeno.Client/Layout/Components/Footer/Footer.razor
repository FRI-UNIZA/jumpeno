@namespace Jumpeno.Client.Layouts

@inherits BasicComponent

<Container Tag="footer" Type="ContainerType.Inline" Boundary PaddingHorizontal Class="@ComputeClass()" Style="@Style">
    <Paragraph Class="footer-text">
        🎮
        <TextSpan NoWrap>
            @I18N.T("Have a nice game (Have a nice)")
            <WebLink Href="@(I18N.Link<GamePage>())" OnClick="() => ActionHandler.BlurFocus()" Class="footer-link">
                @I18N.T("Have a nice game (game)")
            </WebLink>
        </TextSpan>
        ✊
    </Paragraph>
    <Paragraph Class="footer-text copyright">
        @I18N.T("Students from")
        <WebLink
            Href="@URL.Link(I18N.T("LINK_FRI"))"
            Target="WebLinkTarget.Blank"
            Class="footer-link"
        >
            FRI&nbsp;UNIZA
        </WebLink>
        <TextSpan NoWrap>© 2020 - @DateTime.Now.Year</TextSpan>
    </Paragraph>
    <Paragraph Size="TextSize.S" NoWrap Class="footer-text version">
        @I18N.T("Version"): @AppSettings.Version
    </Paragraph>
</Container>
