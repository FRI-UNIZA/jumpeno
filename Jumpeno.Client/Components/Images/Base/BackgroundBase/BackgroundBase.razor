@namespace Jumpeno.Client.Components

@inherits BasicComponent

<div id="@Id" class="@ComputeClass()" style="@Style">
    <ImageBase
        Url="@Url"
        Alt=""
        Class="@ClassImg"
        Style="@Style"
        Draggable="false"
        Transparent
        NoTransition
        Preloaded="Preloaded"
        Loading="ImageLoadingType.Eager"
        OnLoadingFinish="OnImageLoaded"
    />
    <div class="@ClassElement" style="@($"background-image: url('{Url}')")" />
</div>
