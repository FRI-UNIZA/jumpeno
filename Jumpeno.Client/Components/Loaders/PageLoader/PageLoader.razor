@namespace Jumpeno.Client.Components

@inherits ServiceComponent<PageLoader>

<CascadingValue Name="@CascadePageLoaderDisplayed" Value="PageLoaderDisplayed">
    <div class="@ComputeContentClass()" inert="@PageLoaderDisplayed">
        @ChildContent
    </div>
</CascadingValue>
<div class="@ClassBefore" tabindex="0" inert="@(!PageLoaderDisplayed)" @onfocus="@(() => ActionHandler.SetFocus(Id))" />
<div
    id="@Id"
    class="@ComputeClass()"
    style="@Style"
    aria-live="off"
    aria-label="@I18N.T("Loading")"
    role="status"
    tabindex="0"
    inert="@(!PageLoaderDisplayed)"
>
    <PageLoaderIndicator />
</div>
<div class="@ClassAfter" tabindex="0" inert="@(!PageLoaderDisplayed)" @onfocus="@(() => ActionHandler.SetFocus(Id))" />
