@namespace Jumpeno.Client.Components

@inherits BasicComponent

<div
    id="@ViewModel.ID"
    class="@ComputeClass()"
    style="@Style"
    tabindex="@(
        Type == LoadAreaType.Focusable ||
        (Type == LoadAreaType.FocusLoading && ViewModel.Loading)
        ? 0 : -1
    )"
    role="group"
    aria-roledescription="@RoleDescription"
    aria-label="@(ViewModel.Loading ? LoadLabel : Type == LoadAreaType.Focusable ? Label : null)"
>
    <div class="@ClassContent" inert="@ViewModel.Loading">
        @ChildContent
    </div>
    <div class="@ClassLoaderWrap">
        <Loader Class="@ClassLoader" />
    </div>
</div>
