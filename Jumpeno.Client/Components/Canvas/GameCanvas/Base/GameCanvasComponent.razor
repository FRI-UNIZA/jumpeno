@namespace Jumpeno.Client.Components

@inherits Canvas

@code {
    protected RenderFragment RenderComponent() => @<Fragment>
        <div id="@ID" class="@ComputeClass()" style="@($"{ComputeStyle()}{Style}")">
            <BECanvas @ref="CanvasRef" Width="Width" Height="Height" />
            @if (ChildContent != null) {
                <div class="canvas-content">
                    @ChildContent
                </div>
            }
        </div>
    </Fragment>;
}
