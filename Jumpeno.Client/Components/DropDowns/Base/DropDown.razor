@namespace Jumpeno.Client.Components

@inherits BasicComponent

<CascadingValue Name="@CascadeRef" Value="this">
    <div class="@ComputeClass()" style="@Style">
        @if (Displayed) { <div id="@IdStart" class="@ClassStart" tabindex="0" @onfocus="() => ActionHandler.FocusLast(IdOptions)" /> }
        <button type="@ButtonType.Button.String()" id="@IdButton" class="@ClassButton" @onclick="Open" aria-label="@ComputeLabel()">
            @DropDownButton
        </button>
        <div class="@ClassMenu">
            <div class="@ClassMark" />
            <div id="@IdOptions" class="@ClassOptions">
                @Options
            </div>
        </div>
        @if (Displayed) { <div id="@IdEnd" class="@ClassEnd" tabindex="0" @onfocus="() => ActionHandler.SetFocus(IdButton)" /> }
    </div>
</CascadingValue>
