@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[Role.User]">
    <DropDown @ref="DropDownRef" Title="@I18N.T("User menu")" Class="@ClassName">
        <DropDownButton>
            <Image URL="@Auth.User.Skin.ToImagePath()" Transparent Class="@ClassProfileImage" />
        </DropDownButton>
        <Options>
            <DropDownOption Label="@I18N.T("My profile")" Action="OpenProfile">
                <AntIcon Type="setting" Theme="outline" Class="@ClassIcon" Style="font-size: 18px;" />
                <DropDownOptionText>@I18N.T("My profile")</DropDownOptionText>
            </DropDownOption>
            <DropDownOption Label="@I18N.T("Log out")" Action="LogOut">
                <AntIcon Type="logout" Theme="outline" Class="@ClassIcon" Style="margin-top: -1px;" />
                <DropDownOptionText>@I18N.T("Log out")</DropDownOptionText>
            </DropDownOption>
        </Options>
    </DropDown>
    <ProfileModal @ref="@ModalRef" />
</AuthView>
