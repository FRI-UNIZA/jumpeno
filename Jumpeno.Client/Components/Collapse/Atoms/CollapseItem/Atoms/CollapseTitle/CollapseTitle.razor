@namespace Jumpeno.Client.Components

@using CSSClass = Jumpeno.Client.Services.CssClass
@inherits BasicComponent

@code {
    // Constants --------------------------------------------------------------------------------------------------------------------------
    public const string ClassCollapseTitle = "collapse-title";
    public const string ClassCollapseIcon = "collapse-icon";
    
    // Parameters -------------------------------------------------------------------------------------------------------------------------
    [Parameter]
    public required RenderFragment ChildContent { get; set; }

    // Attributes -------------------------------------------------------------------------------------------------------------------------
    public override CSSClass ComputeClass() => base.ComputeClass().Set(ClassCollapseTitle, Base);
}

<div class="@ComputeClass()" style="@Style">
    <div class="@ClassCollapseIcon">
        <AntIcon Type="down" Theme="outline" />
    </div>
    @ChildContent
</div>
