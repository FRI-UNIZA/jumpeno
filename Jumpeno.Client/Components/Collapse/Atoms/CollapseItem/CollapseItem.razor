@namespace Jumpeno.Client.Components

@using CSSClassConstants = Jumpeno.Client.Constants.CSSClassConstants
@inherits BasicComponent

<div class="@ComputeClass()">
    <div class="@CSSClassConstants.NoDisplay">@RenderVar</div>
    <div
        id="@IDTitle"
        class="@ClassCollapseItemTitle"
        @onclick="Toggle"
        @onkeypress="@(async e => { if (e.Key == KeyBoard.Enter) await Toggle(); })"
        role="button"
        aria-controls="@IDContent"
        aria-expanded="@($"{!Collapsed}".ToLower())"
        tabindex="0"
        aria-label="@Label"
    >
        <CollapseTitle>@Title</CollapseTitle>
    </div>
    <div id="@IDContent" class="@ClassCollapseItemContentWrap" inert="@Collapsed">
        <div class="@ClassCollapseItemContent" tabindex="0">
            <CollapseContent>@Content</CollapseContent>
        </div>
    </div>
</div>
