@namespace Jumpeno.Client.Components

@inherits BasicComponent

<Modal
    @ref="@ModalRef"
    Unclosable="@Unclosable"
    Label="@I18N.T("Cookie settings")"
    Class="@CLASS"
    OnCloseFinish="OnClose"
>
    <Content>
        <div class="consent-container">
            <Collapse Surface="CollapseSurface.FLOATING_COLLAPSE">
                <CollapseItem Label="@I18N.T("Mandatory cookies")">
                    <Title>
                        <div class="@CLASS_COOKIE_TITLE">
                            @I18N.T("Mandatory cookies")
                            <SwitchField ViewModel="SwitchMandatoryVM" Label="@I18N.T("Allow mandatory cookies")" AutoSize NoError Disabled />
                        </div>
                    </Title>
                    <Content>
                        @I18N.T("Mandatory cookies text")
                    </Content>
                </CollapseItem>
                <CollapseItem Label="@I18N.T("Preferences")">
                    <Title>
                        <div class="@CLASS_COOKIE_TITLE">
                            @I18N.T("Preferences")
                            <SwitchField ViewModel="SwitchFunctionalVM" Label="@I18N.T("Allow preference cookies")" AutoSize NoError />
                        </div>
                    </Title>
                    <Content>
                        @I18N.T("Preference cookies text")
                    </Content>
                </CollapseItem>
                <CollapseItem Label="@I18N.T("Security")">
                    <Title>
                        <div class="@CLASS_COOKIE_TITLE">
                            @I18N.T("Security")
                            <SwitchField ViewModel="SwitchSecurityVM" Label="@I18N.T("Allow security cookies")" AutoSize NoError />
                        </div>
                    </Title>
                    <Content>
                        <Paragraph Class="category-header">@I18N.T("ReCaptcha")</Paragraph>
                        @((MarkupString)I18N.T("RECAPTCHA_COOKIES_TEXT"))
                    </Content>
                </CollapseItem>
            </Collapse>
            <Paragraph Size="TextSize.S" Class="cookie-paragraph">
                @I18N.T("Cookie message cookie files (Cookie message)")
                <WebLink Href="@I18N.T("Mandatory cookies")" Target="WebLinkTarget.BLANK" Size="TextSize.S" NoWrap Underline>
                    @I18N.T("Cookie message cookie files (cookie files)")
                </WebLink>
            </Paragraph>
        </div>
    </Content>
    <Footer>
        <div class="consent-footer">
            <Button Variant="ButtonVariant.TERTIARY" NoShadow Size="ButtonSize.S" OnClick="@(async () => await AcceptCookies(Selected.Keys.ToList()))">
                <Text>@I18N.T("Accept chosen")</Text>
            </Button>
            <Button Variant="ButtonVariant.TERTIARY" NoShadow Size="ButtonSize.S" OnClick="@(async () => await AcceptCookies(Cookies.TYPES_REQUIRED))">
                <Text>@I18N.T("Only mandatory")</Text>
            </Button>
            <Button Variant="ButtonVariant.QUATERNARY" NoShadow Size="ButtonSize.S" OnClick="@(async () => await AcceptCookies(Cookies.TYPES))">
                <Text>@I18N.T("Accept all")</Text>
            </Button>
        </div>
    </Footer>
</Modal>
