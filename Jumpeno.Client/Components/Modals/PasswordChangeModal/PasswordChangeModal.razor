@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[ROLE.USER]">
    <Modal
        @ref="@ModalRef"
        Label="@I18N.T("Password change")"
        NoFooter
        Class="password-change-modal"
    >
        <Content>
            <div class="password-change-form">
                <div class="password-change-box">
                    <Heading1 Class="password-change-heading" Size="TEXT_SIZE.L">@I18N.T("Password change")</Heading1>
                    <div class="password-change-inputs">
                        <InputField ViewModel="VMPassword" Name="password" Label="@I18N.T("Password")" Size="FORM_SIZE.M" Align="FORM_ALIGN.CENTER" />
                        <InputField ViewModel="VMConfirmPassword" Name="confirm password" Label="@I18N.T("Confirm password")" Size="FORM_SIZE.M" Align="FORM_ALIGN.CENTER" />
                    </div>
                    <Button Size="BUTTON_SIZE.M" OnClick="ChangePassword">
                        <Text>@I18N.T("Change")</Text>
                    </Button>
                </div>
            </div>
        </Content>
    </Modal>
</AuthView>
