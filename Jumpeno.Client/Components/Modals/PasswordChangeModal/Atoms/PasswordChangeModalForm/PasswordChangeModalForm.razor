@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[ROLE.USER]">
    <div class="password-change-form">
        <div class="password-change-box">
            <div class="password-change-inputs">
                <InputField ViewModel="VMPassword" Name="password" Label="@I18N.T("Password")" Size="FORM_SIZE.S" Align="FORM_ALIGN.CENTER" />
                <InputField ViewModel="VMConfirmPassword" Name="confirm password" Label="@I18N.T("Confirm password")" Size="FORM_SIZE.S" Align="FORM_ALIGN.CENTER" />
            </div>
            <Button Size="BUTTON_SIZE.S" OnClick="ChangePassword">
                <Text>@I18N.T("Change")</Text>
            </Button>
        </div>
    </div>
</AuthView>
