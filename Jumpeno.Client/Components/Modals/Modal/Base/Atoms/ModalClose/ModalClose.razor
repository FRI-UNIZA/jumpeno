@namespace Jumpeno.Client.Components

@inherits BasicComponent

<button
    id="@ComputeID()"
    type="@ButtonType.Button.String()"
    class="@ComputeClass()"
    style="@Style"
    @onclick="@Modal.Close"
    aria-label="@I18N.T("Close")"
    inert="@ComputeInert()"
>
    <ThumbButton Class="modal-close-thumb" />
    <AntIcon Type="close" Theme="outline" Class="@ClassIcon" />
</button>
