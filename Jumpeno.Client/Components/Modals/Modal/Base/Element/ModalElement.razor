@namespace Jumpeno.Client.Components

@inherits BasicComponent

<div id="@Modal.Id" inert="@Inert" class="@ComputeClass()" style="@ComputeStyle()">
    <div id="@Modal.IdDialogInit" class="@Modal.ClassInit" tabindex="0" @onfocus="() => ActionHandler.SetFocus(Modal.IdDialog)" />
    <div id="@Modal.IdDialogStart" class="@Modal.ClassStart" tabindex="0" @onfocus="() => ActionHandler.FocusLast(Modal.IdDialog)" />
    <Container Class="@Modal.ClassContainer" PaddingHorizontal PaddingVertical>
        <PageLoaderIndicator Class="@Modal.ClassLoadingIndicator" />
        <section id="@Modal.IdDialog" class="@ComputeDialogClass()" aria-label="@HTML.Label.First(Modal.Label)" role="dialog" tabindex="0">
            @if (!Modal.NoHeader) {
                <div class="@Modal.ClassHeader">
                    @if (Modal.Header is null) {
                        <ModalHeading>@HTML.Label.Render(Modal.Label)</ModalHeading>
                        <ModalClose Modal="Modal" />
                    } else {
                        @Modal.Header
                    }
                </div>
                @if (Modal.SubHeader != null) {
                    <div class="@Modal.ClassSubHeader">
                        @Modal.SubHeader
                    </div>
                }
            }
            <ScrollArea @ref="@Modal.ScrollAreaRef" OverflowX="false" Class="@Modal.ClassScroll" AutoHide="@Modal.ScrollAutoHide">
                <div class="@Modal.ClassContent">
                    <div class="@Modal.ClassContentBox">
                        @Modal.Content
                    </div>
                </div>
            </ScrollArea>
            @if (!Modal.NoFooter) {
                <div class="@Modal.ClassFooter">
                    @Modal.Footer
                </div>
            }
        </section>
    </Container>
    <div id="@Modal.IdDialogEnd" class="@Modal.ClassEnd" tabindex="0" @onfocus="() => ActionHandler.SetFocus(Modal.IdDialog)" />
    <div class="@Modal.ClassBackdrop" @onclick="@(async () => { if (!Modal.Unclosable) await Modal.Close(); })" />
</div>
