@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[Role.USER]">
    <div class="@ComputeClass()" style="@Style">
        <Button Variant="ButtonVariant.PRIMARY" OnClick="ConnectGoogle" Disabled>
            <Icon>
                <AntIcon Type="google" Theme="outline" />
            </Icon>
            <Text>
                @I18N.T("Sign in with Google")
            </Text>
        </Button>
        <Button Variant="ButtonVariant.PRIMARY" OnClick="ConnectFacebook" Disabled>
            <Icon>
                <AntIcon Type="facebook" Theme="outline" />
            </Icon>
            <Text>
                @I18N.T("Connect Facebook account")
            </Text>
        </Button>
    </div>
</AuthView>
