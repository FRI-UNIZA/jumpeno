@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[Role.User]">
    <div class="@ComputeClass()" style="@Style">
        <div class="section">
            <div>
                <Heading1 Size="TextSize.S" Style="font-weight: bold; font-size: 25px;">
                    <AntIcon Type="lock" Theme="outline" Style="margin-right: 5px;" />
                    @I18N.T("Password change"):
                </Heading1>
            </div>
            <div class="input-label">
                @I18N.T("Old password"):
            </div>
            <InputField class="input-field-password" Name="password" Size="FormSize.S" ViewModel="@VMOldPassword" Align="FormAlign.Center"/>
            <div class="input-label">
                @I18N.T("New password"):
            </div>
            <InputField class="input-field-password" Name="password" Size="FormSize.S" ViewModel="@VMNewPassword" Align="FormAlign.Center" />
            <div class="input-label">
                @I18N.T("Confirm password"):
            </div>
            <InputField class="input-field-password" Name="password" Size="FormSize.S" ViewModel="@VMNewPasswordConfirm" Align="FormAlign.Center" />
            <div class="password-strength-mobile">
                <div class="border-mobile">
                    <PasswordStrength Class="strength-meter" Password="@Password" HideLock />
                </div>
            </div>
            <Button Size="ButtonSize.S" OnClick="ChangePassword">
                <Text>
                    @I18N.T("Change password")
                </Text>
            </Button>
        </div>
        <div class="section">
            <div class="password-strength-pc">
                <div class="border">
                    <PasswordStrength Class="strength-meter" Password="@Password" />
                </div>
            </div>
        </div>
    </div>
</AuthView>
