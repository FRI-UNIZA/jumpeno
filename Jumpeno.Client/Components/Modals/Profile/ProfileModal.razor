@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[Role.User]">
    <Modal @ref="@ModalRef"
           Label="@I18N.T("My profile")"
           NoFooter
           Class="profile-modal">
        <Content>
            <div class="profile-modal-tab-switch">
                <div class="profile-tab-buttons">
                    @code {
                        private RenderFragment TabButton(ProfileTabType tab, string iconType) => @<Fragment>
                                <button class="@TabButtonClass(tab)" @onclick="@ChangeTab(tab)">
                                    <AntIcon Type="@iconType" Theme="outline" />
                                    <span class="tab-text">@I18N.T(tab.String())</span>
                                </button>
                        </Fragment>;
                    }
                    @TabButton(ProfileTabType.Account, "user")
                    @TabButton(ProfileTabType.Password, "unlock")
                    @TabButton(ProfileTabType.Connections, "link")
                </div>
                <div class="profile-tabs">
                    @switch (Tab)
                    {
                        case ProfileTabType.Account:
                            <AccountTab ModalRef="@ModalRef" />
                            break;
                        case ProfileTabType.Password:
                            <PasswordChangeTab />
                            break;
                        case ProfileTabType.Connections:
                            <SocialsTab />
                            break;
                    }
                </div>
            </div>
        </Content>
    </Modal>
</AuthView>
