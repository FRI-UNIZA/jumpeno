@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[ROLE.USER]">
    <Modal
        @ref="@ModalRef"
        Label="@I18N.T("My profile")"
        NoFooter
        Class="profile-modal"
    >
        <Content>
            <LineTabs Position="@TabsPosition" Centered="true" Class="profile-tabs" TabBarClass="profile-tab-bar" OnChanged="x => ResetForms()">
                <TabPane Key="1" Title="@I18N.T("Account")">
                    <AccountTab @ref="AccountRef" ModalRef="@ModalRef" PasswordChangeModalRef="@PasswordChangeModalRef" />
                </TabPane>
                <TabPane Key="2" Title="@I18N.T("Socials")">
                    <SocialsTab @ref="SocialsRef" />
                </TabPane>
                <TabPane Key="3" Title="@I18N.T("Avatar")">
                    <AvatarTab @ref="AvatarRef" />
                </TabPane>
            </LineTabs>
        </Content>
    </Modal>
    <PasswordChangeModal @ref="PasswordChangeModalRef" />
</AuthView>
