@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[ROLE.USER]">
    <Modal
        @ref="@ModalRef"
        Label="@I18N.T("My profile")"
        NoFooter
        Class="profile-modal"
    >
        <Content>
            <div class="profile-modal-tab-switch">
                <div class="profile-tab-buttons">
                    @code {
                        private RenderFragment TabButton(PROFILE_TAB tab) => @<Fragment>
                            <button class="@TabButtonClass(tab)" @onclick="@ChangeTab(tab)">
                                @I18N.T(tab.String())
                            </button>
                        </Fragment>;
                    }
                    @TabButton(PROFILE_TAB.ACCOUNT)
                    @TabButton(PROFILE_TAB.SOCIALS)
                    @TabButton(PROFILE_TAB.AVATAR)
                </div>
                <div class="profile-tabs">
                    @switch (Tab) {
                        case PROFILE_TAB.ACCOUNT:
                            <AccountTab ModalRef="@ModalRef" PasswordChangeModalRef="@PasswordChangeModalRef" />
                        break;
                        case PROFILE_TAB.SOCIALS:
                            <SocialsTab />
                        break;
                        case PROFILE_TAB.AVATAR:
                            <AvatarTab />
                        break;
                    }
                </div>
            </div>
        </Content>
    </Modal>
    <PasswordChangeModal @ref="PasswordChangeModalRef" />
</AuthView>
