@namespace Jumpeno.Client.Components

@inherits BasicComponent

<AuthView Roles="[Role.USER]">
    <Modal
        @ref="@ModalRef"
        Label="@I18N.T("My profile")"
        NoFooter
        Class="profile-modal"
    >
        <Content>
            <div class="profile-modal-tab-switch">
                <div class="profile-tab-buttons">
                    @code {
                        private RenderFragment TabButton(ProfileTabType tab) => @<Fragment>
                            <button class="@TabButtonClass(tab)" @onclick="@ChangeTab(tab)">
                                @I18N.T(tab.String())
                            </button>
                        </Fragment>;
                    }
                    @TabButton(ProfileTabType.ACCOUNT)
                    @TabButton(ProfileTabType.SOCIALS)
                    @TabButton(ProfileTabType.AVATAR)
                </div>
                <div class="profile-tabs">
                    @switch (Tab) {
                        case ProfileTabType.ACCOUNT:
                            <AccountTab ModalRef="@ModalRef" PasswordChangeModalRef="@PasswordChangeModalRef" />
                        break;
                        case ProfileTabType.SOCIALS:
                            <SocialsTab />
                        break;
                        case ProfileTabType.AVATAR:
                            <AvatarTab />
                        break;
                    }
                </div>
            </div>
        </Content>
    </Modal>
    <PasswordChangeModal @ref="PasswordChangeModalRef" />
</AuthView>
