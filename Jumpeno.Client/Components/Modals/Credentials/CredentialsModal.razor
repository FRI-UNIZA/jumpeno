@namespace Jumpeno.Client.Components

<AuthView Roles="[Role.ADMIN]">
    <Modal
        @ref="@ModalRef"
        Label="@Label"
        NoFooter
        OnCloseFinish="ClearModal"
        Class="credentials-modal"
    >
        <Content>
            @foreach (var credential in Credentials) {
                <Paragraph Size="TextSize.M" Class="modal-item">@credential</Paragraph>
            }
        </Content>
    </Modal>
</AuthView>
