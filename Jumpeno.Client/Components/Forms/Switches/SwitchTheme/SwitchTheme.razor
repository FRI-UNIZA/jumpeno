@namespace Jumpeno.Client.Components

@inherits BasicComponent

<SwitchComponent
    ViewModel="SwitchVM"
    Label="@I18N.T("Light theme")"
    Variant="FormVariant.Primary"
    Size="FormSize.S"
    Class="@ComputeClass()"
    Style="@Style"
    Position="SwitchPosition.End"
    ActiveDescription
    AutoSize
    NoError
>
    <Description>
        <AntIcon Type="fire" Theme="outline" Class="switch-theme-icon" />
    </Description>
</SwitchComponent>
