@namespace Jumpeno.Client.Components

@inherits FormField<CheckBoxViewModel>

@code {
    protected override FormErrorType? ErrorType => FormErrorType.PASSIVE;
    protected override RenderFragment RenderField() => @<Fragment>
        <button
            id="@ViewModel.FormID"
            type="@ButtonType.BUTTON.String()"
            class="@CLASS_ELEMENT"
            role="checkbox"
            aria-label="@HTML.Label.Aria(Label, ViewModel.Value)"
            aria-checked="@HTML.Label.AriaActive(ViewModel.Value)"
            @onclick="ChangeValue"
            disabled="@Disabled"
        >
            @if (Icon != null) {
                @Icon
            } else {
                <div class="@CLASS_ICON">
                    <div class="checkbox-icon-start" />
                    <div class="checkbox-icon-end" />
                </div>
            }
        </button>
        @if (Description != null) {
            <div
                class="@CLASS_DESCRIPTION"
                @onclick="@(ActiveDescription ? async () => await ChangeValue() : () => {})"
            >
                @Description
            </div>
        }
    </Fragment>;
}

@Render()
