@namespace Jumpeno.Client.Components

@inherits BasicComponent

<div class="@ComputeClass()" style="@Style">
    <div class="rules-header">
        <div class="rules-header-content">
            <AntIcon Type="info-circle" Theme="Outline" Class="info-circle" />
            <span>@I18N.T("Password rules"):</span>
        </div>
   </div>

    <div class="bar">
        @for (int i = 0; i < SEGMENTS; i++)
        {
            <div class="@SegmentClass(i < FilledSegments)" />
        }
    </div>

    <div class="rules-section">
        <div class="rules">
            @for (int i = 0; i < UserValidator.PASSWORD_RULES.Length; i++)
            {
                <div class="@RuleClass(!UserValidator.PASSWORD_RULES[i].invalid(Password))">
                    <span class="dot">@(!UserValidator.PASSWORD_RULES[i].invalid(Password) ? "✓" : "●") </span>
                    <span class="text">@I18N.T("Password rule n" + (i + 1)) </span>
                </div>
            }
        </div>
        <AntIcon Type="lock" Theme="outline" Class="lock-icon" />
    </div>
</div>
